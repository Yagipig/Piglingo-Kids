{
  "expo": {
    "name": "Piglingo Kids",
    "slug": "piglingo-kids",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "piglingo",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.piglingo.kids",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Piglingo Kids cần dùng micro để bé ghi âm và luyện phát âm."
      }
    },
    "android": {
      "package": "com.piglingo.kids",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Piglingo Kids cần dùng micro để bé ghi âm và luyện phát âm."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Piglingo Kids cần quyền truy cập thư viện ảnh để bạn chọn ảnh làm nền cho ứng dụng."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/Piglingo-Kids"
    },
    "extra": {
      "router": {}
    }
  }
}
