{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "destination": "/Piglingo-Kids", "permanent": false }
  ],
  "rewrites": [
    { "source": "/Piglingo-Kids/:path*", "destination": "/:path*" },
    { "source": "/Piglingo-Kids", "destination": "/" },
    { "source": "/Piglingo-Kids/", "destination": "/" }
  ]
}
